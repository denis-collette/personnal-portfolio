---
interface Props {
  title: string;
}
const { title } = Astro.props;

const credlyIconSVG = `<svg fill="currentColor" viewBox="0 0 48 48"><path d="m33.77,27.04c-.71-.5-1.68-.32-2.18.39-2.14,2.96-5.22,5.57-9.58,5.57s-4.62-7.88-2-13c1.61-3.14,3.87-5.73,5.84-5.72,1.39,0,2.18,1.26,1.8,2.6-.46,1.63-.51,2.72-.51,2.81-.04.96.71,1.77,1.68,1.8.02,0,.04.01.07.01.93,0,1.7-.74,1.74-1.68,0-.03.18-3.31,2.78-6.77.63-.84.39-2.07-.57-2.59-.77-.42-1.75-.14-2.27.56-.15.2-.29.39-.42.59-.14.2-.4.27-.62.17-7.7-3.47-12.07,3.86-13.51,7.23-3,7-3,18,5.62,18,7.22,0,10.63-4.75,12.6-7.79.46-.71.27-1.66-.42-2.14-.01,0-.02-.02-.03-.02Z"/></svg>`;
const githubIconSVG = `<svg fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.168 6.839 9.492.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.031-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.378.203 2.398.1 2.651.64.7 1.03 1.595 1.03 2.688 0 3.848-2.338 4.695-4.566 4.942.359.308.682.92.682 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.001 10.001 0 0022 12c0-5.523-4.477-10-10-10z" clip-rule="evenodd" /></svg>`;
const linkedinIconSVG = `<svg fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Denis Collette's personal portfolio website."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{Astro.props.title}</title>
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-base-100 text-base-content">
    <header
      id="main-header"
      class="bg-base-100 shadow-md sticky top-0 z-40 h-[68px]"
    >
      <div class="container flex justify-between items-center h-full">
        <a href="/" class="hover:opacity-80 transition-opacity">
          <div class="flex items-center h-full">
            <img
              src="/logo.png"
              alt="Denis Collette logo"
              class="h-20 w-auto object-contain"
            />
            <img
              src="/baseline.png"
              alt="Denis Collette baseline"
              class="h-48 w-auto object-contain ml-4 hidden sm:block"
            />
          </div>
        </a>
        <div class="flex items-center gap-4">
          <nav id="desktop-nav" class="hidden md:flex items-center gap-2">
            <a href="/" class="nav-link">Home</a>
            <a href="/cv" class="nav-link">My CV</a>
            <a href="/projects" class="nav-link">Projects</a>
          </nav>

          <button
            id="theme-toggle"
            class="relative w-8 h-8 flex items-center justify-center cursor-pointer"
            aria-label="Toggle theme"
          >
            <svg
              id="theme-icon-sun"
              class="fill-current w-6 h-6"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              ><path
                d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"
              ></path></svg
            >
            <svg
              id="theme-icon-moon"
              class="fill-current w-6 h-6"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              ><path fill="#ffffff" stroke="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.353 3C5.849 4.408 3 7.463 3 11.47A9.53 9.53 0 0 0 12.53 21c4.007 0 7.062-2.849 8.47-6.353C8.17 17.065 8.14 8.14 9.353 3z"/></svg
            >
          </button>

          <button id="burger-menu-button" class="md:hidden z-[60] p-1 relative">
            <svg
              id="burger-icon"
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16m-7 6h7"></path></svg
            >
            <svg
              id="close-icon"
              class="w-6 h-6 hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path></svg
            >
          </button>
        </div>
      </div>
      <div
        id="mobile-menu-overlay"
        class="fixed inset-0 bg-base-100/95 z-50 hidden md:hidden flex-col items-center justify-center gap-6"
      >
        <a href="/" class="nav-link nav-link-mobile">Home</a>
        <a href="/cv" class="nav-link nav-link-mobile">My CV</a>
        <a href="/projects" class="nav-link nav-link-mobile">Projects</a>
      </div>
    </header>

    <div class="flex-grow flex flex-col">
      <slot />
    </div>

    <footer class="bg-base-200 text-base-content p-10">
      <div
        class="container flex flex-col sm:flex-row justify-between items-center text-center sm:text-left gap-6"
      >
        <div>
          <p class="font-bold">Denis Collette</p>
          <p>Full-Stack Developer</p>
          <p class="text-sm opacity-70 mt-2">
            © {new Date().getFullYear()} - All rights reserved
          </p>
        </div>
        <div class="flex justify-center gap-6">
          <a
            href="https://github.com/denis-collette"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="hover:text-secondary"
            ><span class="sr-only">GitHub</span><div
              class="w-8 h-8"
              set:html={githubIconSVG}
            /></a
          >
          <a
            href="https://linkedin.com/in/denis-collette/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="hover:text-secondary"
            ><span class="sr-only">LinkedIn</span><div
              class="w-8 h-8"
              set:html={linkedinIconSVG}
            /></a
          >
          <a
            href="https://www.credly.com/users/denis-collette.83478a41/badges"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Credly"
            class="hover:text-secondary"
            ><span class="sr-only">Credly</span><div
              class="w-8 h-8"
              set:html={credlyIconSVG}
            /></a
          >
        </div>
      </div>
    </footer>

    <script>
      // Burger menu script
      const burgerButton = document.getElementById("burger-menu-button"),
        mobileMenu = document.getElementById("mobile-menu-overlay"),
        burgerIcon = document.getElementById("burger-icon"),
        closeIcon = document.getElementById("close-icon");
      function toggleMenu() {
        mobileMenu?.classList.toggle("hidden"),
          mobileMenu?.classList.toggle("flex"),
          burgerIcon?.classList.toggle("hidden"),
          closeIcon?.classList.toggle("hidden");
      }
      burgerButton?.addEventListener("click", toggleMenu),
        mobileMenu?.querySelectorAll("a").forEach((e) => {
          e.addEventListener("click", () => {
            mobileMenu?.classList.contains("hidden") || toggleMenu();
          });
        });

      // Active link script
      document.addEventListener("DOMContentLoaded", () => {
        const e = window.location.pathname;
        document.querySelectorAll(".nav-link").forEach((t) => {
          const n = t as HTMLAnchorElement,
            l = n.getAttribute("href"),
            s = e === l || (l !== "/" && e.startsWith(l));
          s && n.setAttribute("aria-current", "page");
        });
      });

      // Theme toggle script
      const toggleBtn = document.getElementById("theme-toggle");
      const sunIcon = document.getElementById("theme-icon-sun");
      const moonIcon = document.getElementById("theme-icon-moon");
      const htmlEl = document.documentElement;

      function setIconVisibility() {
        if (htmlEl.getAttribute("data-theme") === "dark") {
          sunIcon?.classList.add("hidden");
          moonIcon?.classList.remove("hidden");
        } else {
          sunIcon?.classList.remove("hidden");
          moonIcon?.classList.add("hidden");
        }
      }

      toggleBtn?.addEventListener("click", () => {
        const currentTheme = htmlEl.getAttribute("data-theme");
        if (currentTheme === "dark") {
          htmlEl.setAttribute("data-theme", "light");
          localStorage.setItem("theme", "light");
        } else {
          htmlEl.setAttribute("data-theme", "dark");
          localStorage.setItem("theme", "dark");
        }
        setIconVisibility();
      });

      setIconVisibility();
    </script>
  </body>
</html>
<style is:global>
  @import "../styles/global.css";
</style>
