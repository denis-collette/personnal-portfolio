                      stroke-linejoin="round"
                      d="m19.5 8.25-7.5 7.5-7.5-7.5"
                    />
                  </svg>
                </div>
                <div class="card-body">
                  <p class="text-sm pt-4 border-t border-base-content/10 mt-4">
