          professionalExperience.map((event, index) => (
            <div
              class:list={[
                "timeline-event",
                { "md:flex-row-reverse": event.align === "right" },
              ]}
            >
              <div class="hidden md:block md:w-5/12" />
              <div class="timeline-bubble">
                <span class="font-semibold text-primary-content">
                  {professionalExperience.length - index}
                </span>
              </div>
              <div class="timeline-card">
                <div class="card-header">
                  <div>
                    <span class="font-semibold text-sm text-secondary">
                      {event.type}
                    </span>
                    <h3 class="text-xl font-bold mt-1">{event.title}</h3>
                    <p class="text-md font-semibold opacity-80">
                      {event.company}
                    </p>
                    <p class="text-sm opacity-60 mb-2">{event.date}</p>
                  </div>
                  <svg
                    class="w-6 h-6 opacity-50 transition-transform duration-300 chevron"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
