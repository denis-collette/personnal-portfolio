---
import NarraticaApp from "../projects/narratica/App.jsx";
---

<div class="narratica-container">
  <NarraticaApp client:load />
</div>

<style>
  @import "../projects/narratica/styles/narratica.css";

  .narratica-container :global(a) {
    color: inherit;
    text-decoration: none;
  }
  .narratica-container :global(a:hover) {
    color: inherit;
    text-decoration: none;
  }
  
  .narratica-container :global(h1),
  .narratica-container :global(h2),
  .narratica-container :global(h3),
  .narratica-container :global(h4),
  .narratica-container :global(h5),
  .narratica-container :global(h6) {
    font-size: unset;
    font-weight: unset;
    line-height: unset;
    color: unset;
  }

  .narratica-container :global(p) {
    margin: unset;
    line-height: unset;
    color: unset;
  }

  .narratica-container :global(button) {
    background: unset;
    border: unset;
    color: unset;
    padding: unset;
  }
</style>
