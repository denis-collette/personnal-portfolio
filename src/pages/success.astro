---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Message Sent!">
  <main
    class="flex-grow flex flex-col justify-center items-center text-center p-8"
  >
    <div class="max-w-xl">
      <h1 class="text-4xl md:text-5xl font-extrabold text-secondary">
        Thank You!
      </h1>
      <p class="mt-6 text-lg md:text-xl opacity-80">
        Your message has been sent successfully. I'll get back to you as soon as
        possible.
      </p>
      <div class="mt-10">
        <a href="/" class="btn btn-neutral"> &larr; Back to Homepage </a>
      </div>
    </div>
  </main>
</Layout>
