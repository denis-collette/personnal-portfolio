---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Message Sent!">
  <main class="min-h-screen bg-gray-900 text-white flex flex-col justify-center items-center text-center p-8">
    <div class="max-w-xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-extrabold text-indigo-400">
        Thank You!
      </h1>
      <p class="mt-6 text-lg md:text-xl text-gray-300">
        Your message has been sent successfully. I'll get back to you as soon as possible.
      </p>
      <div class="mt-10">
        <a
          href="/"
          class="px-8 py-3 bg-indigo-600 hover:bg-indigo-700 rounded-md font-bold transition-transform duration-300 transform hover:scale-105"
        >
          &larr; Back to Homepage
        </a>
      </div>
    </div>
  </main>
</Layout>