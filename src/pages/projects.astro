---
import Layout from "../layouts/Layout.astro";
import PokemiltonGame from "../components/PokemiltonGame.astro";
import Didlycthulhudoo from "../components/Didlycthulhudoo.astro";
---

<Layout title="My Projects | Denis Collette">
  <main>
    <div class="bg-base-200 text-center py-16 px-4">
      <h1
        class="text-4xl md:text-5xl font-extrabold tracking-tight text-secondary"
      >
        My Projects
      </h1>
      <p class="mt-4 text-lg opacity-80 max-w-2xl mx-auto">
        A showcase of applications, websites and programs I've built.
      </p>
      <p
        class="mt-8 text-sm opacity-70 max-w-3xl mx-auto italic border-t border-base-content/20 pt-4"
      >
        The versions on this page have been rebuilt specifically for this
        portfolio to run directly in the browser. The original projects were
        often more extensive and included full backends. Feel free to explore
        the original code on GitHub for the full picture!
      </p>
    </div>

    <nav class="subnav-container">
      <div class="subnav">
        <a href="#narratica" class="subnav-link">Narratica</a>
        <a href="#pokemilton" class="subnav-link">Pokemilton Game</a>
        <a href="#didlycthulhudoo" class="subnav-link">Didlycthulhudoo</a>
        <a href="#more-projects" class="subnav-link">More Coming Soon</a>
      </div>
    </nav>

    <section id="narratica" class="section-padding bg-base-100">
      <div class="container text-center">
        <h2 class="text-3xl font-bold text-secondary mb-4">Narratica (integration in progress)</h2>
        <p class="max-w-2xl mx-auto mb-4 opacity-80">
          An audiobook listening platform based on Spotify. I took the lead
          developer hat and supervised the project but I also made the database
          and the backend setup and sketching, investigate the deployement
          possibilities (we used AWS) and I completely create the audio
          visualizer in the frontend part (the easter egg). This was the final
          group project made during my training at BeCode.
        </p>
        <p class="mb-8">
          <a
            href="https://github.com/denis-collette/Narratica-MountainProject"
            target="_blank"
            rel="noopener noreferrer"
          >
            Discover the original code on GitHub &rarr;
          </a>
        </p>

        <iframe
          src="/projects/narratica-embed"
          class="w-full h-[85vh] min-h-[550px] max-h-[800px] border-none rounded-lg mx-auto"
          title="Narratica application embed"
          frameborder="0"
          scrolling="no"
        >
        </iframe>

      </div>
    </section>

    <section id="pokemilton" class="section-padding bg-base-200">
      <div class="container text-center">
        <h2 class="text-3xl font-bold text-secondary mb-4">Pokemilton Game</h2>
        <p class="max-w-2xl mx-auto mb-4 opacity-80">
          An interactive version of a terminal-based RPG I built in
          collaboration with a binome during my training.
        </p>
        <p class="mb-8">
          <a
            href="https://github.com/denis-collette/Pokemilton"
            target="_blank"
            rel="noopener noreferrer"
          >
            Discover the original code on GitHub &rarr;
          </a>
        </p>
        <PokemiltonGame />
      </div>
    </section>

    <section id="didlycthulhudoo" class="section-padding bg-base-100">
      <div class="container text-center">
        <h2 class="text-3xl font-bold text-secondary mb-4">Didlycthulhudoo</h2>
        <p class="max-w-2xl mx-auto mb-4 opacity-80">
          An event scheduling application inspired by Doodle, built with React.
          This was a collaborative project that demonstrates component-based
          architecture, state management, and handling user interactions.
        </p>
        <p class="mb-8">
          <a
            href="https://github.com/denis-collette/Didlycthulhudo"
            target="_blank"
            rel="noopener noreferrer"
          >
            Discover the original code on GitHub &rarr;
          </a>
        </p>
        <Didlycthulhudoo />
      </div>
    </section>

    <div class="border-b border-base-content/20"></div>

    <section id="more-projects" class="section-padding bg-base-200">
      <div class="container text-center">
        <h2 class="text-3xl font-bold mb-4">More on the way...</h2>
        <p class="max-w-2xl mx-auto opacity-80">
          I'm always working on something new. Check back soon for more
          projects!
        </p>
      </div>
    </section>
  </main>
</Layout>
