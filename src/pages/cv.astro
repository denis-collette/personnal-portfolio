---
import Layout from "../layouts/Layout.astro";
import CVTimeline from "../components/CVTimeline.astro";
---

<Layout title="My CV - Denis Collette">
  <main>
    <div class="bg-base-200 text-center py-16 px-4">
      <h1
        class="text-4xl md:text-5xl font-extrabold tracking-tight text-secondary"
      >
        My Professional Journey
      </h1>
      <p class="mt-4 text-lg opacity-80 max-w-2xl mx-auto">
        An interactive timeline of my experience and education.
      </p>
    </div>

    <div class="subnav-container">
      <nav class="subnav">
        <a href="#experience" class="subnav-link">Experience</a>
        <a href="#education" class="subnav-link">Education</a>
        <a href="#certifications" class="subnav-link">Certifications</a>
      </nav>
    </div>

    <div class="bg-base-100">
      <CVTimeline />
    </div>
  </main>
</Layout>
