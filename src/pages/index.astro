---
import Layout from "../layouts/Layout.astro";
import HomepageSubNav from "../components/HomepageSubNav.astro";
import Icon from "../components/Icon.astro";

// Skill data
const skills = {
  languagesFrameworks: [
    { name: "Angular", icon: "devicon-angularjs-plain colored" },
    { name: "Astro", icon: "devicon-astro-plain colored" },
    { name: "Tailwind CSS", icon: "devicon-tailwindcss-plain colored" },
    { name: "TypeScript", icon: "devicon-typescript-plain colored" },
    { name: "JavaScript", icon: "devicon-javascript-plain colored" },
    { name: "HTML5", icon: "devicon-html5-plain colored" },
    { name: "CSS3", icon: "devicon-css3-plain colored" },
    { name: "SCSS", icon: "devicon-sass-original colored" },
    { name: "Node.js", icon: "devicon-nodejs-plain colored" },
    { name: "Express", icon: "devicon-express-original colored" },
    { name: "React", icon: "devicon-react-original colored" },
    { name: "Next.js", icon: "devicon-nextjs-plain colored" },
    { name: "Python", icon: "devicon-python-plain colored" },
    { name: "Django", icon: "devicon-django-plain colored" },
    { name: "PHP", icon: "devicon-php-plain colored" },
    { name: "Laravel", icon: "devicon-laravel-plain colored" },
  ],
  cloudDevOps: [
    { name: "AWS", icon: "devicon-amazonwebservices-plain-wordmark colored" },
    {
      name: "Amplify",
      icon: "devicon-amazonwebservices-line-wordmark colored",
    },
    { name: "Docker", icon: "devicon-docker-plain colored" },
  ],
  databases: [
    { name: "SQL", icon: "devicon-sqldeveloper-plain colored" },
    { name: "PostgreSQL", icon: "devicon-postgresql-plain colored" },
    { name: "MySQL", icon: "devicon-mysql-plain colored" },
    { name: "MariaDB", icon: "devicon-mariadb-plain colored" },
  ],
  tools: [
    { name: "Git / GitHub", icon: "devicon-git-plain colored" },
    { name: "Linux", icon: "devicon-linux-plain" },
    { name: "Windows", icon: "devicon-windows8-original colored" },
    { name: "macOS", icon: "devicon-apple-original colored" },
  ],
};

// Define categories for the accordion
const skillCategories = [
  { title: "Languages & Frameworks", key: "languagesFrameworks" },
  { title: "Cloud & DevOps", key: "cloudDevOps" },
  { title: "Databases", key: "databases" },
  { title: "Tools & Operating Systems", key: "tools" },
];

const softSkills = [
  "Problem Solving",
  "Adaptability",
  "Organization",
  "Fast Learner",
  "Curiosity",
  "Communication",
  "Teamwork",
  "Client Relations",
];
---

<Layout title="Denis Collette - Full-Stack Developer & Cybersecurity">
  <main>
    <!-- Hero Section -->
    <section
      id="home"
      class="relative min-h-[calc(100svh-67px)] flex flex-col justify-center items-center text-center p-8 pb-20"
    >
      <div class="max-w-4xl mx-auto">
        <img
          src="/logoFull.png"
          alt="Denis Collette Full Stack Developer"
          class="w-full max-w-40 sm:max-w-xs mx-auto block"
        />
        <p class="mt-6 text-lg md:text-xl max-w-2xl mx-auto">
          A versatile marketer and manager transitioning into
          <strong>web development and cybersecurity</strong>. After years in
          communication, leisure management, and retail, I've completed intensive
          full-stack training. Now, I'm eager to blend my strong problem-solving
          and communication skills with my new passion for
          <strong>coding and digital security</strong>
          to build
          <strong>innovative and secure</strong>
          solutions.
        </p>
        <div
          class="mt-10 flex w-full max-w-xs sm:max-w-none flex-col sm:flex-row justify-center gap-4"
        >
          <a href="/cv" class="btn btn-neutral w-full sm:w-auto">View My CV</a>
          <a href="/projects" class="btn btn-neutral w-full sm:w-auto"
            >My Projects</a
          >
          <a href="#contact" class="btn btn-neutral w-full sm:w-auto"
            >Get In Touch</a
          >
        </div>
        <p class="text-center pt-8">
          <a
            href="https://github.com/denis-collette/personnal-portfolio"
            target="_blank"
            rel="noopener noreferrer"
          >
            Discover the original code on GitHub &rarr;
          </a>
        </p>
      </div>

      <a
        href="#about"
        aria-label="Scroll down"
        class="absolute bottom-5 left-1/2 -translate-x-1/2 animate-bounce text-secondary"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-8 w-8"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </a>
    </section>

    <HomepageSubNav />

    <!-- About Me Section -->
    <section id="about" class="section-padding bg-base-200">
      <div class="container text-center">
        <h2 class="text-3xl font-bold mb-4 section-title">About Me</h2>
        <p class="max-w-2xl mx-auto">
          Beyond the code, I'm an avid gamer and reader. I thrive on learning
          new things and solving puzzles, whether it's in a virtual world or a
          complex codebase. I am a native French speaker and fluent in English.
        </p>
      </div>
    </section>

    <!-- Current Focus Section -->
    <section id="focus" class="section-padding">
      <div class="container text-center">
        <h2 class="text-3xl font-bold mb-4 section-title">Current Focus</h2>
        <p class="max-w-2xl mx-auto text-lg">
          Having recently completed intensive training in
          <strong>full-stack development and cybersecurity</strong>, my goal is to
          secure a challenging role in the Walloon Ardennes region. I am actively
          seeking opportunities where I can contribute to a dynamic team,
          <strong>build secure applications</strong>, and continue to grow my skills
          in
          <strong>both development and defense</strong>.
        </p>
      </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="section-padding bg-base-200">
      <div class="container">
        <h2 class="text-3xl font-bold text-center mb-12 section-title">
          Technical Skills
        </h2>

        <!-- Accordion for Skills -->
        <div class="max-w-6xl mx-auto">
          {
            skillCategories.map((category) => {
              const skillList = skills[category.key as keyof typeof skills];
              if (!skillList || skillList.length === 0) return null;

              return (
                <details class="certification-category-group group border-b border-base-content/10 last:border-b-0 mb-2">
                  <summary class="list-none flex justify-between items-center cursor-pointer p-4 rounded-lg transition-colors hover:bg-base-200/50">
                    <h3 class="text-2xl font-bold">{category.title}</h3>
                    <svg
                      class="w-6 h-6 transition-transform duration-300 group-open:rotate-180"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m19.5 8.25-7.5 7.5-7.5-7.5"
                      />
                    </svg>
                  </summary>
                  
                  <!-- Smaller Skill Cards Grid -->
                  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 py-6 px-2">
                    {skillList.map((skill) => (
                      <div class="flex items-center p-3 bg-base-100 rounded-lg shadow-md gap-3">
                        <Icon name={skill.icon} />
                        <span class="font-medium text-sm">{skill.name}</span>
                      </div>
                    ))}
                  </div>

                </details>
              );
            })
          }
        </div>

        <div class="mt-16 text-center">
          <h3 class="text-3xl font-bold text-center mb-12 section-title">
            Soft Skills
          </h3>
          <div class="flex flex-wrap justify-center gap-3">
            {
              softSkills.map((skill) => (
                <span class="soft-skill-badge">
                  <strong>{skill}</strong>
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="section-padding">
      <div class="container">
        <div class="max-w-xl mx-auto text-center">
          <h2 class="text-3xl font-bold mb-4 section-title">Get In Touch</h2>
          <p class="opacity-80 max-w-xl mx-auto mb-8">
            Have a question or want to work together? Leave your details and
            I'll get back to you.
          </p>
        </div>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          action="/success"
          netlify-honeypot="bot-field"
          class="max-w-xl mx-auto mt-8"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label
              >Don’t fill this out if you’re human: <input
                name="bot-field"
              /></label
            >
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium">Name</label>
              <input
                type="text"
                name="name"
                id="name"
                required
                class="form-input"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium">Email</label>
              <input
                type="email"
                name="email"
                id="email"
                required
                class="form-input"
              />
            </div>
          </div>
          <div class="mt-6">
            <label for="message" class="block text-sm font-medium"
              >Message</label
            >
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="form-input"></textarea>
          </div>
          <div class="mt-6 text-center">
            <button type="submit" class="btn btn-neutral">Send Message</button>
          </div>
        </form>
      </div>
    </section>
  </main>
</Layout>